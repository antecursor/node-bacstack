{
  "plugins": [
    "plugins/markdown"
  ],
  "source": {
    "include": [
      "index.js",
      "lib"
    ],
    "includePattern": ".+\\.js$",
    "excludePattern": "lib/client/"
  },
  "opts": {
    "destination": "docs",
    "encoding": "utf8",
    "package": "package.json",
    "readme": "README.md",
    "recurse": true,
    "template": "node_modules/docdash"
  },
  "templates": {
    "cleverLinks": true,
    "monospaceLinks": false
  }
}
