{
  "name": "bacstack",
  "version": "0.0.1-beta.20",
  "description": "A BACnet protocol stack written in pure JavaScript.",
  "main": "index.js",
  "files": [
    "index.js",
    "lib/",
    "BACNET_SC.md",
    "CHANGELOG.md",
    "FAQ.md",
    "LICENSE.md",
    "README.md"
  ],
  "scripts": {
    "lint": "eslint .",
    "lint:prune": "eslint . --prune-suppressions",
    "lint:commits": "commitlint --from master --to HEAD",
    "changelog": "npm run lint:commits",
    "test": "mocha \"test/unit/**/*.spec.js\" \"test/integration/**/*.spec.js\"",
    "test:unit": "mocha \"test/unit/**/*.spec.js\"",
    "test:integration": "mocha \"test/integration/**/*.spec.js\"",
    "test:coverage": "c8 npm test",
    "integration": "npm run test:integration",
    "test:sc": "mocha test/integration/bacnet-sc.spec.js",
    "test:sc:java": "./scripts/run-sc-java-fixture.sh",
    "test:sc:java:client": "node scripts/bacnet-sc-java-fixture-test.js",
    "compose:sc:up": "docker compose -f docker-compose.bacnet-sc.yml up --build -d",
    "compose:sc:down": "docker compose -f docker-compose.bacnet-sc.yml down -v",
    "example:sc": "node examples/bacnet-sc.js",
    "compliance": "mocha \"test/compliance/**/*.spec.js\"",
    "docs": "jsdoc --configure jsdoc.json",
    "package:check": "npm pack --dry-run --json",
    "verify": "npm run lint && npm run test:coverage && npm run docs && npm run package:check"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/antecursor/node-bacstack.git"
  },
  "keywords": [
    "bacnet",
    "bacstack",
    "building",
    "automation"
  ],
  "author": {
    "name": "Fabio Huser",
    "email": "fabio@fh1.ch"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "npm@11.18.0",
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/fh1ch/node-bacstack/issues"
  },
  "homepage": "https://github.com/antecursor/node-bacstack#readme",
  "dependencies": {
    "debug": "^4.0.1",
    "iconv-lite": "^0.4.24"
  },
  "overrides": {
    "diff": "^8.0.4",
    "glob": "^13.0.6",
    "serialize-javascript": "^7.0.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "c8": "^12.0.0",
    "chai": "^4.5.0",
    "docdash": "^2.0.2",
    "eslint": "^10.7.0",
    "globals": "^17.7.0",
    "jsdoc": "^4.0.5",
    "mocha": "^11.7.6"
  }
}
